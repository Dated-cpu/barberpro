// ============================================================
// BarberPro — Prisma Schema
// Стек: PostgreSQL 16 + Prisma ORM
// Версия: 1.0.0
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  GUEST
  CLIENT
  BARBER
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  CANCELLED
}

enum BookingSource {
  WEBSITE
  INSTAGRAM
  TELEGRAM
  PHONE
  IN_PERSON
  WHATSAPP
  VK
  ADMIN
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_CHANGED
  REVIEW_REPLY
  PROMOTION
  SYSTEM
  LOYALTY
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MediaProvider {
  LOCAL
  S3
  R2
  MINIO
}

// ============================================================
// CORE — User, Media, Branch
// ============================================================

/// Пользователь системы.
/// Роли: GUEST (без регистрации), CLIENT, BARBER, ADMIN, SUPER_ADMIN.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  firstName     String
  lastName      String
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  emailVerified           Boolean   @default(false)
  phoneVerified           Boolean   @default(false)
  verificationToken       String?   // хеш токена подтверждения email
  verificationTokenExpiresAt DateTime? @db.Timestamptz
  resetPasswordToken      String?   // хеш токена сброса пароля
  resetPasswordExpiresAt  DateTime? @db.Timestamptz
  lastLogin               DateTime? @db.Timestamptz
  avatarId      String?   @db.Uuid
  description   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz

  // Relations
  avatar             Media?             @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  sessions           Session[]
  clientAppointments Appointment[]     @relation("ClientAppointments")
  barberAppointments Appointment[]     @relation("BarberAppointments")
  workingDays        WorkingDay[]
  blockedSlots       BlockedSlot[]
  portfolios         Portfolio[]
  reviews            Review[]
  moderatedReviews   Review[]         @relation("ModeratedReviews")
  notifications      Notification[]
  auditLogs          AuditLog[]
  uploadedMedia      Media[]           @relation("UploadedBy")
  consents           UserConsent[]
  settings           Setting[]
  branchAssignments  UserBranch[]

  // Индексы
  @@index([role, isActive])
  // Поиск активных пользователей по роли — быстрый список барберов/админов на публичной странице.

  @@index([deletedAt])
  // Исключение мягко удалённых записей из всех запросов.

  @@map("users")
}

/// Филиал. Подготовка к multi-tenant архитектуре с несколькими точками.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Europe/Moscow")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  services     Service[]
  appointments Appointment[]
  workingDays  WorkingDay[]
  blockedSlots BlockedSlot[]
  galleryItems Gallery[]
  staff        UserBranch[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("branches")
}

/// Связь пользователя с филиалом (many-to-many).
/// Один пользователь может работать в нескольких филиалах.
model UserBranch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  role      UserRole
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  // Одна связь пользователя с филиалом.

  @@index([branchId])
  // Поиск всех сотрудников филиала.
  @@map("user_branches")
}

/// Универсальное хранилище медиафайлов.
/// Поддерживает: локальное хранение, S3, Cloudflare R2, MinIO.
/// Любое изображение в системе ссылается на Media через FK.
model Media {
  id           String        @id @default(uuid()) @db.Uuid
  filename     String
  mimeType     String
  size         Int           // байты
  width        Int?
  height       Int?
  alt          String?
  provider     MediaProvider @default(LOCAL)
  bucket       String?
  key          String        // путь в хранилище
  url          String
  thumbnailUrl String?
  hash         String?       // SHA-256 для дедупликации и целостности
  uploadedById String?       @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  deletedAt    DateTime?     @db.Timestamptz

  uploadedBy      User?            @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  userAvatars     User[]           @relation("UserAvatar")
  serviceImages   Service[]        @relation("ServiceImage")
  portfolioImages PortfolioImage[]
  galleryItems    Gallery[]
  reviewImages    ReviewImage[]

  @@index([provider, key])
  // Быстрый поиск по провайдеру и ключу.

  @@index([uploadedById])
  @@index([hash])
  // Дедупликация — проверка существования файла по хешу.

  @@index([deletedAt])
  @@map("media")
}

// ============================================================
// AUTH — RefreshToken, Session
// ============================================================

/// Refresh token для JWT. Хранится в виде хеша (не plaintext).
/// Поддерживает ротацию: старый токен помечается как revoked.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  family    String    // идентификатор семейства токенов (для ротации)
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session?

  @@unique([tokenHash])
  // Быстрый поиск по хешу при валидации refresh token.

  @@index([userId])
  // Поиск всех токенов пользователя для массовой инвалидации.

  @@index([family])
  // Поиск по семейству для детекции кражи (reuse detection).

  @@index([expiresAt])
  // Очистка просроченных токенов (cron job).

  @@map("refresh_tokens")
}

/// Сессия пользователя (устройство).
/// Позволяет отслеживать активные сессии и управлять ими.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  device       String?  // название устройства
  ip           String?
  userAgent    String?
  refreshTokenId String? @unique @db.Uuid
  expiresAt      DateTime @db.Timestamptz
  lastActiveAt   DateTime @default(now()) @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([userId, lastActiveAt])
  // Активные сессии пользователя, сортировка по активности.

  @@index([expiresAt])
  // Очистка просроченных сессий.

  @@map("sessions")
}

// ============================================================
// BUSINESS — Service, WorkingDay, BlockedSlot, Appointment
// ============================================================

/// Услуга барбера.
/// Цена и длительность фиксируются на момент создания записи (см. Appointment.priceAtBooking).
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int      // минуты
  category    String?  // "haircut", "beard", "styling", "coloring", "shave"
  imageId     String?  @db.Uuid
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  branchId    String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  image       Media?         @relation("ServiceImage", fields: [imageId], references: [id], onDelete: SetNull)
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([isActive, sortOrder])
  // Сортировка активных услуг для публичной страницы.

  @@index([category, isActive])
  // Фильтр услуг по категории.

  @@index([branchId, isActive])
  // Услуги филиала.

  @@index([deletedAt])
  @@map("services")
}

/// Рабочий день барбера.
/// Двойное назначение:
///   — Шаблон: date = null, dayOfWeek = 1..7 (еженедельное расписание)
///   — Переопределение: date = конкретная дата, dayOfWeek = null (выходной/особый день)
model WorkingDay {
  id         String   @id @default(uuid()) @db.Uuid
  barberId   String   @db.Uuid
  date       DateTime? @db.Date   // null = шаблон
  dayOfWeek  Int?                // 1 (Mon) .. 7 (Sun), null = переопределение
  startTime  String              // "HH:mm"
  endTime    String              // "HH:mm"
  breakStart String?             // "HH:mm" — начало обеда
  breakEnd   String?             // "HH:mm" — конец обеда
  isDayOff   Boolean  @default(false)
  branchId   String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  barber User   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([barberId, date])
  // Одно переопределение на барбера на дату.

  @@unique([barberId, dayOfWeek])
  // Один шаблон на день недели на барбера.
  // PostgreSQL: NULL в unique считается уникальным,
  // поэтому dayOfWeek = null (переопределения) не конфликтуют.

  @@index([barberId, isDayOff])
  // Поиск выходных барбера.

  @@index([barberId, date, isDayOff])
  // Проверка, работает ли барбер в конкретную дату.

  @@map("working_days")
}

/// Блокировка слота (отпуск, болезнь, личные дела).
/// Переопределяет WorkingDay для конкретного временного диапазона.
model BlockedSlot {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @db.Uuid
  startTime DateTime @db.Timestamptz
  endTime   DateTime @db.Timestamptz
  reason    String?
  branchId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  barber User   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([barberId, startTime, endTime])
  // Поиск пересекающихся блокировок для конкретного барбера.

  @@index([startTime, endTime])
  // Глобальный поиск блокировок во временном диапазоне.

  @@index([deletedAt])
  @@map("blocked_slots")
}

/// Запись на услугу. Центральная бизнес-сущность.
/// Цена и длительность фиксируются на момент записи (snapshot).
/// Статус отражает жизненный цикл: PENDING → CONFIRMED → IN_PROGRESS → COMPLETED
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  clientId         String            @db.Uuid
  barberId         String            @db.Uuid
  serviceId        String            @db.Uuid
  branchId         String?           @db.Uuid
  startTime        DateTime          @db.Timestamptz
  endTime          DateTime          @db.Timestamptz
  status           AppointmentStatus @default(PENDING)
  source           BookingSource     @default(WEBSITE)
  notes            String?   // заметки барбера (внутренние)
  clientNotes      String?   // комментарий клиента при записи
  priceAtBooking   Decimal   @db.Decimal(10, 2) // цена на момент записи
  durationAtBooking Int                // длительность на момент записи (мин)
  paymentStatus    PaymentStatus      @default(PENDING)
  paymentId        String?            // ID платежа в платёжной системе (будущее)
  cancelledAt      DateTime?          @db.Timestamptz
  cancelReason     String?
  cancelledBy      String?            // "client", "barber", "admin", "system"
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  deletedAt        DateTime?          @db.Timestamptz

  client  User    @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  barber  User    @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  notifications Notification[] @relation("AppointmentNotifications")
  review       Review?

  @@index([barberId, startTime, endTime])
  // Поиск пересекающихся записей барбера — проверка доступности слота.
  // Самый частый запрос: "свободен ли барбер в это время?"

  @@index([barberId, status, startTime])
  // Расписание барбера на день с фильтром по статусу.
  // Используется на странице админки "сегодняшние записи".

  @@index([clientId, startTime])
  // История записей клиента (личный кабинет).

  @@index([status, startTime])
  // Поиск предстоящих записей по статусу (для напоминаний).

  @@index([branchId, startTime])
  // Расписание филиала.

  @@index([source])
  // Аналитика: какие каналы привлекают больше записей.

  @@index([createdAt])
  // Аналитика: новые записи за период.

  @@index([deletedAt])
  @@map("appointments")
}

// ============================================================
// CONTENT — Gallery, Portfolio, Review
// ============================================================

/// Публичная галерея работ (главная страница, портфолио барбершопа).
model Gallery {
  id        String   @id @default(uuid()) @db.Uuid
  mediaId   String   @db.Uuid
  caption   String?
  category  String?           // "haircut", "beard", "styling", "shave", "process"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  branchId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  media  Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  // Активные элементы галереи в правильном порядке.

  @@index([category, isActive])
  // Фильтр по категории.

  @@index([deletedAt])
  @@map("gallery")
}

/// Портфолио барбера (набор работ).
model Portfolio {
  id          String   @id @default(uuid()) @db.Uuid
  barberId    String   @db.Uuid
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  barber User            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  images PortfolioImage[]

  @@index([barberId, sortOrder])
  // Портфолио барбера в правильном порядке.

  @@index([deletedAt])
  @@map("portfolios")
}

/// Изображение портфолио (одна работа может содержать несколько фото "до/после").
model PortfolioImage {
  id          String   @id @default(uuid()) @db.Uuid
  portfolioId String   @db.Uuid
  mediaId     String   @db.Uuid
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([portfolioId, sortOrder])
  // Изображения портфолио в правильном порядке.

  @@index([mediaId])
  @@map("portfolio_images")
}

/// Отзыв клиента на выполненную запись.
/// Модерация: PENDING → APPROVED / REJECTED.
model Review {
  id            String       @id @default(uuid()) @db.Uuid
  clientId      String       @db.Uuid
  appointmentId String       @unique @db.Uuid
  rating        Int          // 1–5
  text          String?
  status        ReviewStatus @default(PENDING)
  moderatedAt   DateTime?    @db.Timestamptz
  moderatedById String?      @db.Uuid
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz
  deletedAt     DateTime?    @db.Timestamptz

  client      User         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  moderator   User?        @relation("ModeratedReviews", fields: [moderatedById], references: [id], onDelete: SetNull)
  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  images      ReviewImage[]

  @@index([status, rating])
  // Публичные отзывы, отсортированные по рейтингу.

  @@index([clientId])
  // История отзывов клиента.

  @@index([appointmentId])
  @@index([createdAt])
  // Свежие отзывы на главной.

  @@index([deletedAt])
  @@map("reviews")
}

/// Изображение в отзыве (фото результата).
model ReviewImage {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  mediaId   String   @db.Uuid
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([reviewId])
  @@index([mediaId])
  // Поиск всех отзывов с конкретным изображением (для дедупликации при удалении Media).
  @@map("review_images")
}

// ============================================================
// SYSTEM — Notification, AuditLog, Event, Setting
// ============================================================

/// Уведомление пользователя.
/// Поддерживает: in-app, email, sms, push, telegram.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  appointmentId String?          @db.Uuid
  type         NotificationType
  title        String
  body         String?
  data         Json?            @db.JsonB // гибкий payload: { appointmentId, reviewId, ... }
  channel      String?          // "in_app", "email", "sms", "push", "telegram"
  externalId   String?          // ID во внешней системе (Telegram message ID, SendGrid ID)
  isRead       Boolean          @default(false)
  readAt       DateTime?        @db.Timestamptz
  sentAt       DateTime?        @db.Timestamptz
  deliveredAt  DateTime?        @db.Timestamptz
  failedAt     DateTime?        @db.Timestamptz
  errorMessage String?
  createdAt    DateTime         @default(now()) @db.Timestamptz

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation("AppointmentNotifications", fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  // Лента уведомлений пользователя.

  @@index([userId, isRead])
  // Непрочитанные уведомления (счётчик в UI).

  @@index([type, createdAt])
  // Статистика уведомлений по типу.

  @@index([createdAt])
  // Очистка старых уведомлений.

  @@map("notifications")
}

/// Аудит всех значимых действий в системе.
/// Каждое действие администратора или критическое событие фиксируется здесь.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid   // null = системное действие
  action     String              // "appointment.create", "service.update", "user.login", ...
  entityType String             // "Appointment", "Service", "User", "Setting", ...
  entityId   String?   @db.Uuid // UUID изменённой сущности
  oldValue   Json?    @db.JsonB // snapshot "до"
  newValue   Json?    @db.JsonB // snapshot "после"
  ip         String?
  userAgent  String?
  metadata   Json?    @db.JsonB // дополнительный контекст
  createdAt  DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  // История действий пользователя.

  @@index([action, createdAt])
  // Сколько раз произошло конкретное действие.

  @@index([entityType, entityId])
  // История изменений конкретной сущности.

  @@index([createdAt])
  // Выборка за период.

  @@map("audit_logs")
}

/// Event Outbox — Transactional Outbox Pattern.
/// События записываются в той же транзакции, что и бизнес-операция,
/// затем отдельный процесс публикует их в шину.
/// Гарантирует at-least-once delivery без distributed transactions.
model Event {
  id            String      @id @default(uuid()) @db.Uuid
  eventType     String      // "appointment.created", "appointment.cancelled", "user.registered"
  aggregateType String      // "Appointment", "User", "Review"
  aggregateId   String      @db.Uuid
  payload       Json        @default("{}") @db.JsonB
  status        EventStatus @default(PENDING)
  publishedAt   DateTime?   @db.Timestamptz
  failureCount  Int         @default(0)
  lastError     String?
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  @@index([status, createdAt])
  // Очередь событий, ожидающих обработки.

  @@index([eventType, createdAt])
  // Поиск событий по типу.

  @@index([aggregateType, aggregateId])
  // Все события, связанные с сущностью.

  @@map("events")
}

/// Согласие пользователя на обработку данных и принятие документов.
/// Фиксирует факт, версию документа и техническую информацию.
model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  consentType     String   // "privacy" | "terms" | "personal_data" | "booking_rules" | "cookies"
  documentVersion Int
  ip              String?
  userAgent       String?
  acceptedAt      DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, consentType])
  // История согласий пользователя по типу документа.

  @@index([consentType, acceptedAt])
  // Статистика принятий по типу документа.

  @@index([acceptedAt])
  // Очистка по дате.

  @@map("user_consents")
}

/// Настройки системы и барберов.
/// scopeId = "system" — глобальные настройки (название, адрес, контакты)
/// scopeId = UUID барбера — настройки конкретного барбера (буфер, макс. клиентов)
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  value       Json     @db.JsonB
  type        String   @default("string") // "string", "number", "boolean", "json"
  description String?
  scopeId     String   // "system" или UUID барбера
  barberId    String?  @db.Uuid // FK для referential integrity
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  barber User? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([scopeId, key])
  // Уникальность ключа в рамках scope.
  // scopeId всегда NOT NULL, поэтому unique работает корректно.

  @@index([scopeId])
  // Все настройки одного scope (система или барбер).

  @@index([barberId])
  @@map("settings")
}
